# Local (non-container) runs. In compose and k8s these come from the
# environment, not from a file.
DATABASE_URL=postgresql+psycopg://notes:notes@localhost:5432/notes
OIDC_ISSUER=http://localhost:8080/auth/realms/notes
OIDC_JWKS_URL=http://localhost:8080/auth/realms/notes/protocol/openid-connect/certs
OIDC_AUDIENCE=notes-api
CORS_ORIGINS=["http://localhost:5173"]
